<?xml version="1.0"?>
<!-- The Z1 on its own, link00 fixed to world, with its ros2_control block and, for gz-sim, the
     gz_ros2_control plugin. Arguments:
       variant       unitree_gripper (default), bota_probe or robotiq_2f85: see z1_macro.xacro
       with_gripper  the gripper motor is wired (default true)
       with_camera   the variant's cameras (default true)
       sim_ignition  gz-sim hardware and plugin (default true); false loads z1_hardware_interface
       name, prefix, controllers  for ros2_control -->
<robot name="z1_description" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:arg name="name" default="z1" />
    <xacro:arg name="prefix" default="" />
    <xacro:arg name="controllers" default="$(find z1_bringup)/config/z1_controllers.yaml" />
    <xacro:arg name="sim_ignition" default="true" />
    <xacro:arg name="variant" default="unitree_gripper" />
    <xacro:arg name="with_gripper" default="true" />
    <xacro:arg name="with_camera" default="true" />

    <xacro:include filename="$(find z1_description)/urdf/z1_macro.xacro" />
    <xacro:include filename="$(find z1_description)/urdf/z1.ros2_control.xacro" />

    <link name="world" />

    <xacro:z1 parent="world" mount_joint="base_static_joint" variant="$(arg variant)"
              with_gripper="$(arg with_gripper)" with_camera="$(arg with_camera)">
        <origin rpy="0 0 0" xyz="0 0 0" />
    </xacro:z1>

    <xacro:if value="$(arg sim_ignition)">
        <gazebo reference="world" />
        <gazebo>
            <plugin filename="gz_ros2_control-system"
                name="gz_ros2_control::GazeboSimROS2ControlPlugin">
                <parameters> $(arg controllers) </parameters>
                <robot_param> robot_description </robot_param>
                <robot_param_node> robot_state_publisher </robot_param_node>
                <controller_manager_name> controller_manager </controller_manager_name>
            </plugin>
        </gazebo>
    </xacro:if>

    <xacro:z1_ros2_control
        name="$(arg name)"
        prefix="$(arg prefix)"
        sim_ignition="$(arg sim_ignition)"
        with_gripper="$(arg with_gripper)" />

</robot>
