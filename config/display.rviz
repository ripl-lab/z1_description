Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Cell Size: 0.1
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Enabled: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Alpha: 0.6
      Visual Enabled: true
      Collision Enabled: false
      Enabled: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Marker Scale: 0.15
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Frames:
        All Enabled: true
      Enabled: true
  Global Options:
    Fixed Frame: world
    Background Color: 48; 48; 48
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 0.7
      Focal Point:
        X: 0.2
        Y: 0
        Z: 0.2
      Pitch: 0.4
      Yaw: 0.8
